(require 'ert)
(require 'reka)

(defmacro reka-test--with-layout (&rest body)
  "Run BODY with native calls stubbed, real Emacs windows, and isolated buffers."
  (declare (indent 0) (debug t))
  `(let ((reka-handle 'test-handle)
         (reka--focused-floating-buffer nil)
         (reka--floating-keymap-active nil)
         (reka--last-focused nil)
         (reka--adjusting-floating-layout nil)
         (reka--floating-selection-context nil)
         (reka-window-created-hook nil)
         (reka-window-geometry-change-hook nil)
         (reka-floating-state-change-hook nil)
         (split-width-threshold 0)
         (split-height-threshold 0)
         (before (buffer-list))
         (old-name (frame-parameter nil 'name))
         (old-tabs (frame-parameter nil 'tabs))
         calls)
     (cl-letf (((symbol-function 'reka-window-equal) #'equal)
               ((symbol-function 'reka-close-window) (lambda (&rest args) (push (cons 'close args) calls)))
               ((symbol-function 'reka-set-focus-request) (lambda (&rest args) (push (cons 'focus args) calls)))
               ((symbol-function 'reka-make-window-parameters) (lambda (&rest args) args))
               ((symbol-function 'reka-toggle-window-floating) (lambda (&rest args) (push (cons 'toggle args) calls)))
               ((symbol-function 'reka-move-floating-window) (lambda (&rest args) (push (cons 'move args) calls)))
               ((symbol-function 'reka-resize-floating-window) (lambda (&rest args) (push (cons 'resize args) calls)))
               ((symbol-function 'reka-center-floating-window) (lambda (&rest args) (push (cons 'center args) calls)))
               ((symbol-function 'reka--handle-event) #'ignore))
       (unwind-protect
           (save-window-excursion
             (delete-other-windows)
             (set-frame-parameter nil 'name "reka-frame-test")
             (set-frame-parameter nil 'tabs nil)
             ,@body)
         (set-frame-parameter nil 'name old-name)
         (set-frame-parameter nil 'tabs old-tabs)
         (dolist (buffer (seq-difference (buffer-list) before))
           (when (buffer-live-p buffer)
             (with-current-buffer buffer (setq reka-window nil))
             (kill-buffer buffer)))))))

(defun reka-test--parameter-windows ()
  (apply #'append
         (mapcar (lambda (frame) (mapcar #'car (append frame nil)))
                 (append (reka--all-window-parameters) nil))))

(ert-deftest reka-floating-dialog-does-not-retile-its-parent ()
  (reka-test--with-layout
    (let ((parent (reka--create-buffer 'parent)))
      (switch-to-buffer parent)
      (delete-other-windows)
      (let* ((before-edges (window-pixel-edges))
             (dialog (reka--create-buffer 'dialog t 'parent)))
        (should (= (length (window-list)) 1))
        (should (equal (window-pixel-edges) before-edges))
        (should (eq (window-buffer) parent))
        (should-not (get-buffer-window dialog t))
        (should (buffer-local-value 'reka-floating dialog))
        (should (equal (sort (reka-test--parameter-windows)
                            (lambda (a b) (string< (symbol-name a) (symbol-name b))))
                       '(dialog parent)))))))

(ert-deftest reka-floating-toggle-removes-and-restores-a-real-tiled-slot ()
  (reka-test--with-layout
    (let ((parent (reka--create-buffer 'parent))
          (child (reka--create-buffer 'child)))
      (switch-to-buffer parent)
      (delete-other-windows)
      (set-window-buffer (split-window-right) child)
      (should (= (length (window-list)) 2))
      (reka--apply-window-geometry child t "reka-frame-test" '(100 90 640 480))
      (should (= (length (window-list)) 1))
      (should (eq (window-buffer) parent))
      (should-not (get-buffer-window child t))
      (should (memq 'child (reka-test--parameter-windows)))
      (reka--apply-window-geometry child nil "reka-frame-test" '(0 0 400 300))
      (should-not (buffer-local-value 'reka-floating child))
      (should (window-live-p (get-buffer-window child t)))
      (should (memq 'child (reka-test--parameter-windows))))))

(ert-deftest reka-floating-detach-keeps-focus-through-deferred-window-hooks ()
  (reka-test--with-layout
    (let ((parent (reka--create-buffer 'parent))
          (child (reka--create-buffer 'child)))
      (switch-to-buffer parent)
      (delete-other-windows)
      (let ((child-window (split-window-right)))
        (set-window-buffer child-window child)
        (select-window child-window))
      (reka--apply-window-geometry child t "reka-frame-test" '(100 90 640 480))
      (should-not reka--adjusting-floating-layout)
      (should (eq (window-buffer) parent))
      ;; Emacs delivers these notifications during redisplay, after the
      ;; dynamic guard around deleting the child's tiled slot has unwound.
      (with-current-buffer (window-buffer)
        (reka--selection-changed (selected-frame))
        (reka--selection-changed (selected-frame)))
      (should (eq (reka--active-application-buffer) child))
      (should reka--floating-keymap-active)
      (reka-floating-toggle)
      (should (member '(toggle test-handle child) calls))
      (should-not (member '(toggle test-handle parent) calls)))))

(ert-deftest reka-floating-explicit-buffer-selection-clears-native-focus ()
  (reka-test--with-layout
    (let ((child (reka--create-buffer 'child)))
      (switch-to-buffer child)
      (delete-other-windows)
      (reka--apply-window-geometry child t "reka-frame-test" '(100 90 640 480))
      (switch-to-buffer (get-buffer-create "*reka-explicit-editing*"))
      (reka--selection-changed (selected-frame))
      (should-not reka--focused-floating-buffer)
      (should-not reka--floating-keymap-active)
      (should-error (reka-floating-toggle) :type 'user-error))))

(ert-deftest reka-floating-explicit-window-selection-clears-native-focus ()
  (reka-test--with-layout
    (switch-to-buffer (get-buffer-create "*reka-selected-before-floating*"))
    (let* ((other (split-window-right))
           (dialog (reka--create-buffer 'dialog t)))
      (set-window-buffer other (get-buffer-create "*reka-explicit-other-window*"))
      (select-window other)
      (reka--selection-changed (selected-frame))
      (should-not reka--focused-floating-buffer)
      (should-not (eq (reka--active-application-buffer) dialog)))))

(ert-deftest reka-floating-minibuffer-hooks-preserve-the-application-target ()
  (reka-test--with-layout
    (let ((dialog (reka--create-buffer 'dialog t))
          (minibuffer (minibuffer-window)))
      (cl-letf (((symbol-function 'selected-window) (lambda () minibuffer))
                ((symbol-function 'minibuffer-depth) (lambda () 1)))
        (reka--selection-changed (selected-frame))
        (should (eq reka--focused-floating-buffer dialog))
        (should-not reka--floating-keymap-active)
        (should (equal (car calls) '(focus test-handle nil))))
      (reka--selection-changed (selected-frame))
      (should (eq (reka--active-application-buffer) dialog))
      (should reka--floating-keymap-active))))

(ert-deftest reka-floating-recursive-edit-does-not-mask-explicit-selection ()
  (reka-test--with-layout
    (reka--create-buffer 'dialog t)
    (cl-letf (((symbol-function 'recursion-depth) (lambda () 1)))
      (switch-to-buffer (get-buffer-create "*reka-recursive-editing*"))
      (reka--selection-changed (selected-frame))
      (should-not reka--focused-floating-buffer)
      (should-not reka--floating-keymap-active))))

(ert-deftest reka-floating-command-target-is-the-native-focused-buffer ()
  (reka-test--with-layout
    (let ((dialog (reka--create-buffer 'dialog t)))
      (with-temp-buffer
        (should (eq (reka--active-application-buffer) dialog))
        (reka-floating-toggle)
        (reka-floating-move-left)
        (reka-floating-grow-height)
        (reka-floating-center))
      (should (member '(toggle test-handle dialog) calls))
      (should (member '(move test-handle dialog -32 0) calls))
      (should (member '(resize test-handle dialog 0 32) calls))
      (should (member '(center test-handle dialog) calls))
      (with-current-buffer dialog (setq reka--floating-tab 'inactive-tab))
      (with-temp-buffer
        (should-not (reka--active-application-buffer))
        (should-error (reka-floating-toggle) :type 'user-error)))))

(ert-deftest reka-floating-membership-follows-tabs-without-reserving-a-window ()
  (reka-test--with-layout
    (let* ((tab-bar-tab-post-open-functions '(reka--new-tab))
           (tab-bar-tab-post-select-functions '(reka--tab-selected))
           (dialog (reka--create-buffer 'dialog t))
           (original-id (buffer-local-value 'reka--floating-tab dialog)))
      (should (reka--floating-visible-p dialog))
      (tab-bar-new-tab)
      (should-not (eq original-id (reka--current-tab-id)))
      (should-not (reka--floating-visible-p dialog))
      (should-not (memq 'dialog (reka-test--parameter-windows)))
      (tab-bar-select-tab 1)
      (should (eq original-id (reka--current-tab-id)))
      (should (reka--floating-visible-p dialog))
      (should (memq 'dialog (reka-test--parameter-windows)))
      (should-not (get-buffer-window dialog t)))))

(ert-deftest reka-floating-geometry-hooks-and-close-clean-up-focus ()
  (reka-test--with-layout
    (let ((dialog (reka--create-buffer 'dialog t))
          geometry-events state-events)
      (with-current-buffer dialog
        (add-hook 'reka-window-geometry-change-hook
                  (lambda () (push reka-floating-geometry geometry-events)) nil t)
        (add-hook 'reka-floating-state-change-hook
                  (lambda () (push reka-floating state-events)) nil t))
      (reka--apply-window-geometry dialog t "reka-frame-test" '(10 20 300 200))
      (should (equal geometry-events '((10 20 300 200))))
      (should-not state-events)
      (reka--apply-window-geometry dialog nil "reka-frame-test" '(0 0 400 300))
      (should (equal state-events '(nil)))
      (setq reka--focused-floating-buffer dialog)
      (kill-buffer dialog)
      (should-not reka--focused-floating-buffer))))

(ert-deftest reka-floating-mode-keys-use-the-existing-intercepted-prefix ()
  (should (eq (lookup-key reka-mode-map (kbd "C-x w f")) #'reka-floating-toggle))
  (should (eq (lookup-key reka-mode-map (kbd "C-x w <left>")) #'reka-floating-move-left))
  (should (eq (lookup-key reka-mode-map (kbd "C-x w S-<down>")) #'reka-floating-grow-height))
  (should (member "C-x" reka-intercept-prefixes)))

(ert-deftest reka-floating-keys-work-over-an-ordinary-underlying-buffer ()
  (reka-test--with-layout
    (let ((dialog (reka--create-buffer 'dialog t))
          (emulation-mode-map-alists '(reka--floating-emulation-map-alist)))
      (with-temp-buffer
        (should (eq (reka--active-application-buffer) dialog))
        (should (eq (key-binding (kbd "C-x w f")) #'reka-floating-toggle))
        (should (eq (key-binding (kbd "C-x w <right>")) #'reka-floating-move-right))))))

(ert-deftest reka-floating-focus-can-return-after-an-emacs-command ()
  (reka-test--with-layout
    (reka--create-buffer 'dialog t)
    (with-temp-buffer
      (let ((this-command 'execute-extended-command))
        (reka--update-focus-request))
      (should (equal (car calls) '(focus test-handle nil)))
      (let ((this-command nil))
        (reka--update-focus-request))
      (should (equal (car calls) '(focus test-handle dialog))))))

(ert-deftest reka-floating-emulation-does-not-capture-minibuffer-editing ()
  (reka-test--with-layout
    (let ((dialog (reka--create-buffer 'dialog t))
          (emulation-mode-map-alists '(reka--floating-emulation-map-alist)))
      (with-temp-buffer
        (should (eq (key-binding (kbd "C-x w f")) #'reka-floating-toggle))
        (cl-letf (((symbol-function 'minibuffer-depth) (lambda () 1)))
          (reka--refresh-floating-keymap)
          (should-not reka--floating-keymap-active)
          (should-not (eq (key-binding (kbd "C-x w f")) #'reka-floating-toggle))
          ;; A completed application command can still find its explicit target.
          (should (eq (reka--active-application-buffer) dialog)))
        (reka--refresh-floating-keymap)
        (should reka--floating-keymap-active)
        (should (eq (key-binding (kbd "C-x w f")) #'reka-floating-toggle))))))

(ert-deftest reka-floating-parent-reused-in-another-tab-keeps-dialogs-visible ()
  (reka-test--with-layout
    (let* ((tab-bar-tab-post-open-functions '(reka--new-tab))
           (parent (reka--create-buffer 'parent)))
      (switch-to-buffer parent)
      (delete-other-windows)
      (reka--all-window-parameters)
      (let ((old-id (buffer-local-value 'reka--floating-tab parent)))
        (tab-bar-new-tab)
        (switch-to-buffer parent)
        (delete-other-windows)
        (reka--all-window-parameters)
        (should-not (eq old-id (buffer-local-value 'reka--floating-tab parent)))
        (should (reka--floating-visible-p (reka--create-buffer 'dialog t 'parent)))))))

(ert-deftest reka-floating-pending-geometry-does-not-unminimize-a-dialog ()
  (reka-test--with-layout
    (reka--create-buffer 'parent)
    (let ((dialog (reka--create-buffer 'dialog t 'parent)))
      (with-current-buffer dialog (setq reka--floating-tab nil))
      (reka--apply-window-geometry dialog t "reka-frame-test" '(20 30 400 300))
      (should-not (buffer-local-value 'reka--floating-tab dialog))
      (should-not (reka--floating-visible-p dialog))
      (should-not (memq 'dialog (reka-test--parameter-windows))))))

